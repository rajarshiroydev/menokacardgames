DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/DATABASE/auth
NEON_AUTH_COOKIE_SECRET=generate-a-random-secret-with-at-least-32-characters

# Account purge job (daily Vercel Cron, see migrations/0007_account_purge.sql)
CRON_SECRET=generate-a-random-secret-with-at-least-32-characters
PURGE_DATABASE_URL=postgresql://menoka_purge:PASSWORD@HOST/DATABASE?sslmode=require
NEON_API_KEY=project-scoped-neon-api-key
NEON_PROJECT_ID=your-neon-project-id
NEON_AUTH_BRANCH_ID=branch-id-whose-neon-auth-users-are-purged
HEALTHCHECKS_PING_URL=https://hc-ping.com/your-check-uuid
